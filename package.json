{
  "name": "pi-jev-tools",
  "version": "0.1.1",
  "description": "TypeSafe ranking, classification, retrieval and structured-decision tools for Pi coding agents",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "author": "Jabbslad",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jabbslad/pi-jev-tools.git"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "evals/README.md",
    "evals/cases.json",
    "evals/DEVELOPMENT-RESULTS.md",
    "evals/development-metrics.json",
    "evals/DIRECT-PROTOCOL.md",
    "evals/DIRECT-RESULTS.md",
    "evals/direct-metrics.json",
    "evals/RETRIEVAL-PROTOCOL.md",
    "evals/RETRIEVAL-RESULTS.md",
    "evals/retrieval-metrics.json"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:live": "tsx scripts/smoke.ts",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "minimatch": "^10.2.6"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "^22.0.0",
    "csv-parse": "^7.0.2",
    "tsx": "^4.20.0",
    "typebox": "^1.3.7",
    "typescript": "^5.9.0"
  }
}
